# Copy to .env (or ~/.storage1024/config.env). Never commit real values.

# ---- Storage backend -------------------------------------------------------
# auto     = Telegram, else GitHub, else local files (recommended)
# telegram = always Telegram (misconfiguration shows up on /api/health)
# github   = always a GitHub repo (free, durable, no card)
# local    = always local files under DATA_DIR
STORAGE_BACKEND=auto
DATA_DIR=./data

# ---- Telegram credentials (needed for durable storage on Render free tier) --
# Get API_ID / API_HASH from https://my.telegram.org
API_ID=
API_HASH=
# Generate with: python generate_session.py
TELEGRAM_SESSION=
# Numeric channel id (e.g. -1001234567890). The account must be able to post,
# edit and pin messages in it.
CHANNEL_ID=
# Legacy index message id, read only for migrating old deployments.
INDEX_MESSAGE_ID=4

# ---- GitHub credentials (alternative durable backend) ---------------------
# Create a PRIVATE repo and a fine-grained token with Contents: read/write on
# that repo. Data lives in the repo, so ephemeral hosts are safe. Files are
# capped by GITHUB_MAX_FILE_MB (GitHub Contents API caps at 100MB).
GITHUB_TOKEN=
GITHUB_REPO=your-username/storage1024-data
GITHUB_BRANCH=main
GITHUB_PATH=storage1024-data
GITHUB_MAX_FILE_MB=20

# ---- Server tuning ---------------------------------------------------------
PORT=8000
MAX_UPLOAD_MB=1800
# Set to false to disable Telegram upload spacing (local backend ignores it).
THROTTLE_ENABLED=true
# Optional: when set, POST /api/projects/create requires X-Create-Key header.
CREATE_PROJECT_KEY=

# ---- Only for generate_session.py ------------------------------------------
PHONE_NUMBER=
