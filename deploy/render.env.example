# Paste into Render: your Web Service -> Environment -> "Add from .env"
# (or add each key individually). Replace EVERY placeholder. Never commit real values.
STORAGE_BACKEND=telegram
API_ID=REPLACE_WITH_API_ID
API_HASH=REPLACE_WITH_API_HASH
TELEGRAM_SESSION=REPLACE_WITH_STRING_SESSION
CHANNEL_ID=-1000000000000
CREATE_PROJECT_KEY=REPLACE_WITH_RANDOM_HEX
MAX_UPLOAD_MB=1800
THROTTLE_ENABLED=true
PYTHON_VERSION=3.11.9
